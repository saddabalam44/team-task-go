# ====================================
# TeamTaskGo Backend Environment Variables
# ====================================

# Database Connection (MongoDB Atlas or Local MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/teamtaskgo

# JWT Authentication Secret
JWT_SECRET=your_jwt_secret_key_here

# Server Port
PORT=3000

# Email Automation (Gmail App Password)
EMAIL_USER=saddabalam71@gmail.com
EMAIL_PASS=your_gmail_app_password

# Frontend URL (For CORS and links in automated emails)
CLIENT_URL=http://localhost:5173
